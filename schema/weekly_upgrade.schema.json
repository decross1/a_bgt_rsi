{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a-bgt-rsi.local/schema/weekly_upgrade.schema.json",
  "title": "Bounded weekly operational-review artifacts",
  "$ref": "#/$defs/report",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repo_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "repo_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "locator", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/repo_path"},
        "locator": {"type": "string", "minLength": 1, "maxLength": 240},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "external_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "url", "status", "content_sha256", "evidence_excerpt"],
      "properties": {
        "claim": {"type": "string", "minLength": 1, "maxLength": 1000},
        "url": {
          "oneOf": [
            {"type": "string", "format": "uri", "pattern": "^https://"},
            {"type": "null"}
          ]
        },
        "status": {"enum": ["CLAIM_HUMAN_VERIFIED", "UNVERIFIED"]},
        "content_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "evidence_excerpt": {"type": ["string", "null"], "maxLength": 2000}
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "week_id", "snapshot_sha256", "proposal_id",
        "title", "claim", "repo_references", "external_claims",
        "change_surface", "tier", "baseline", "candidate", "experiment",
        "falsifier", "abort_conditions", "execution_scope", "production_change_authorized"
      ],
      "properties": {
        "schema_version": {"const": "weekly-upgrade-v1"},
        "week_id": {"type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$"},
        "snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "proposal_id": {"type": "string", "pattern": "^wu-[0-9a-f]{8}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 160},
        "claim": {"type": "string", "minLength": 1, "maxLength": 1000},
        "repo_references": {
          "type": "array", "minItems": 1, "maxItems": 12,
          "items": {"$ref": "#/$defs/repo_reference"}
        },
        "external_claims": {
          "type": "array", "maxItems": 12,
          "items": {"$ref": "#/$defs/external_claim"}
        },
        "change_surface": {
          "type": "array", "minItems": 1, "maxItems": 12,
          "uniqueItems": true, "items": {"$ref": "#/$defs/repo_path"}
        },
        "tier": {"enum": ["P", "S", "unknown"]},
        "baseline": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "artifact", "artifact_sha256", "measurement_locator", "metric", "value"],
          "properties": {
            "status": {"const": "UNMEASURED"},
            "artifact": {"type": "null"},
            "artifact_sha256": {"type": "null"},
            "measurement_locator": {"type": "null"},
            "metric": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
            "value": {"type": "null"}
          }
        },
        "candidate": {
          "type": "object", "additionalProperties": false,
          "required": ["single_delta"],
          "properties": {
            "single_delta": {"type": "string", "minLength": 1, "maxLength": 500}
          }
        },
        "experiment": {
          "type": "object", "additionalProperties": false,
          "required": [
            "fixture_manifest_path", "fixture_manifest_sha256", "fixture_ids", "arms", "seeds", "max_gpu_minutes",
            "max_wall_minutes", "max_frontier_calls", "primary_metric",
            "guardrails", "pass_rule"
          ],
          "properties": {
            "fixture_manifest_path": {"$ref": "#/$defs/repo_path"},
            "fixture_manifest_sha256": {"$ref": "#/$defs/sha256"},
            "fixture_ids": {
              "type": "array", "minItems": 1, "maxItems": 64,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[A-Za-z0-9_.:/-]{1,120}$"}
            },
            "arms": {
              "type": "array", "minItems": 2, "maxItems": 2,
              "uniqueItems": true,
              "prefixItems": [{"const": "baseline"}, {"const": "candidate"}],
              "items": false
            },
            "seeds": {
              "type": "array", "minItems": 1, "maxItems": 10,
              "uniqueItems": true,
              "items": {"type": "integer", "minimum": 0, "maximum": 2147483647}
            },
            "max_gpu_minutes": {"type": "integer", "minimum": 0, "maximum": 120},
            "max_wall_minutes": {"type": "integer", "minimum": 1, "maximum": 480},
            "max_frontier_calls": {"const": 0},
            "primary_metric": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
            "guardrails": {
              "type": "array", "minItems": 1, "maxItems": 12,
              "items": {"type": "string", "minLength": 1, "maxLength": 500}
            },
            "pass_rule": {"type": "string", "minLength": 1, "maxLength": 500}
          }
        },
        "falsifier": {"type": "string", "minLength": 1, "maxLength": 1000},
        "abort_conditions": {
          "type": "array", "minItems": 1, "maxItems": 12,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        },
        "execution_scope": {"const": "EVALUATION_ONLY"},
        "production_change_authorized": {"const": false}
      }
    },
    "objection": {
      "type": "object", "additionalProperties": false,
      "required": ["claim", "repo_references", "falsifier"],
      "properties": {
        "claim": {"type": "string", "minLength": 1, "maxLength": 1000},
        "repo_references": {
          "type": "array", "maxItems": 12,
          "items": {"$ref": "#/$defs/repo_reference"}
        },
        "falsifier": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "adversary": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "week_id", "snapshot_sha256", "proposal_id",
        "verdict", "violated_rules", "objections", "cheapest_decisive_test",
        "residual_risks", "external_claims"
      ],
      "properties": {
        "schema_version": {"const": "weekly-upgrade-v1"},
        "week_id": {"type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$"},
        "snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "proposal_id": {"type": "string", "pattern": "^wu-[0-9a-f]{8}$"},
        "verdict": {"enum": ["kill", "revise", "survives_to_evaluation"]},
        "violated_rules": {
          "type": "array", "maxItems": 12,
          "items": {"type": "string", "minLength": 1, "maxLength": 1000}
        },
        "objections": {
          "type": "array", "maxItems": 12,
          "items": {"$ref": "#/$defs/objection"}
        },
        "cheapest_decisive_test": {"type": "string", "minLength": 1, "maxLength": 1000},
        "residual_risks": {
          "type": "array", "maxItems": 12,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        },
        "external_claims": {
          "type": "array", "maxItems": 12,
          "items": {"$ref": "#/$defs/external_claim"}
        }
      }
    },
    "unvalidated_response": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "validation_status", "ordinal", "vendor", "role",
        "captured_at", "content_sha256", "original_bytes", "stored_bytes",
        "truncated", "text"
      ],
      "properties": {
        "schema_version": {"const": "weekly-upgrade-unvalidated-response-v1"},
        "validation_status": {"const": "UNVALIDATED"},
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 2},
        "vendor": {"enum": ["codex", "claude"]},
        "role": {"enum": ["upgrade_proposer", "upgrade_adversary"]},
        "captured_at": {"type": "string", "format": "date-time"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "original_bytes": {"type": "integer", "minimum": 0},
        "stored_bytes": {"type": "integer", "minimum": 0, "maximum": 262144},
        "truncated": {"type": "boolean"},
        "text": {"type": "string"}
      }
    },
    "experiment_card": {
      "type": "object", "additionalProperties": false,
      "required": [
        "proposal_id", "proposal_sha256", "snapshot_sha256",
        "fixture_manifest_path", "fixture_manifest_sha256", "fixture_ids",
        "seeds", "primary_metric", "controls", "caps", "pass_rule",
        "guardrails", "abort_conditions", "baseline", "candidate",
        "change_surface", "falsifier", "measurement_ref", "execution_scope",
        "production_change_authorized"
      ],
      "properties": {
        "proposal_id": {"type": "string", "pattern": "^wu-[0-9a-f]{8}$"},
        "proposal_sha256": {"$ref": "#/$defs/sha256"},
        "snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "fixture_manifest_path": {"$ref": "#/$defs/repo_path"},
        "fixture_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "fixture_ids": {
          "type": "array", "minItems": 1, "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9_.:/-]{1,120}$"}
        },
        "seeds": {
          "type": "array", "minItems": 1, "maxItems": 10,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0, "maximum": 2147483647}
        },
        "primary_metric": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "controls": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "prefixItems": [{"const": "baseline"}, {"const": "candidate"}],
          "items": false
        },
        "caps": {
          "type": "object", "additionalProperties": false,
          "required": ["gpu_minutes", "wall_minutes", "frontier_calls"],
          "properties": {
            "gpu_minutes": {"type": "integer", "minimum": 0, "maximum": 120},
            "wall_minutes": {"type": "integer", "minimum": 1, "maximum": 480},
            "frontier_calls": {"const": 0}
          }
        },
        "pass_rule": {"type": "string", "minLength": 1, "maxLength": 500},
        "guardrails": {
          "type": "array", "minItems": 1, "maxItems": 12,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        },
        "abort_conditions": {
          "type": "array", "minItems": 1, "maxItems": 12,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        },
        "baseline": {"$ref": "#/$defs/proposal/properties/baseline"},
        "candidate": {"$ref": "#/$defs/proposal/properties/candidate"},
        "change_surface": {
          "type": "array", "minItems": 1, "maxItems": 12,
          "uniqueItems": true, "items": {"$ref": "#/$defs/repo_path"}
        },
        "falsifier": {"type": "string", "minLength": 1, "maxLength": 1000},
        "measurement_ref": {"type": "null"},
        "execution_scope": {"const": "EVALUATION_ONLY"},
        "production_change_authorized": {"const": false}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": [
        "url", "publisher", "published_at", "accessed_at", "content_sha256",
        "evidence", "verification_status", "verified_claims"
      ],
      "properties": {
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "publisher": {"type": "string", "minLength": 1, "maxLength": 160},
        "published_at": {"type": ["string", "null"], "format": "date"},
        "accessed_at": {"type": "string", "format": "date-time"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "evidence": {"type": "string", "minLength": 1, "maxLength": 2000},
        "verification_status": {"enum": ["HUMAN_VERIFIED", "FETCHED_UNVERIFIED"]},
        "verified_claims": {
          "type": "array", "maxItems": 12,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["claim", "evidence_excerpt"],
            "properties": {
              "claim": {"type": "string", "minLength": 1, "maxLength": 1000},
              "evidence_excerpt": {"type": "string", "minLength": 1, "maxLength": 2000}
            }
          }
        }
      }
    },
    "source_packet": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "sources"],
      "properties": {
        "schema_version": {"const": "weekly-upgrade-source-packet-v1"},
        "sources": {
          "type": "array", "maxItems": 12,
          "items": {"$ref": "#/$defs/source"}
        }
      }
    },
    "stable_benchmark_result": {
      "type": "object", "additionalProperties": false,
      "required": [
        "construct", "domain", "panel", "successful_units", "planned_units",
        "metric", "unit", "value"
      ],
      "properties": {
        "construct": {"type": "string", "minLength": 1, "maxLength": 120},
        "domain": {"type": "string", "minLength": 1, "maxLength": 120},
        "panel": {"type": "string", "minLength": 1, "maxLength": 120},
        "successful_units": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "planned_units": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "metric": {"type": "string", "minLength": 1, "maxLength": 120},
        "unit": {"type": "string", "minLength": 1, "maxLength": 40},
        "value": {"type": "number", "minimum": 0, "maximum": 1000000000}
      }
    },
    "stable_benchmark_arm": {
      "type": "object", "additionalProperties": false,
      "required": [
        "arm_id", "label", "role", "receipt_admission_status", "terminal_status",
        "replay_status", "run_id", "registered_at", "started_at", "finished_at",
        "completed_units", "model_calls", "wall_seconds", "results", "result_interpretation"
      ],
      "properties": {
        "arm_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "label": {"type": "string", "minLength": 1, "maxLength": 240},
        "role": {"type": ["string", "null"], "minLength": 1, "maxLength": 40},
        "receipt_admission_status": {"type": "string", "minLength": 1, "maxLength": 80},
        "terminal_status": {"type": "string", "minLength": 1, "maxLength": 80},
        "replay_status": {"type": "string", "minLength": 1, "maxLength": 80},
        "run_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 200},
        "registered_at": {"type": ["string", "null"], "format": "date-time"},
        "started_at": {"type": ["string", "null"], "format": "date-time"},
        "finished_at": {"type": ["string", "null"], "format": "date-time"},
        "completed_units": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000},
        "model_calls": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000},
        "wall_seconds": {"type": ["number", "null"], "minimum": 0, "maximum": 1000000000},
        "results": {
          "type": "array", "maxItems": 16,
          "items": {"$ref": "#/$defs/stable_benchmark_result"}
        },
        "result_interpretation": {
          "enum": ["receipt_verified_grader_output_only", "not_scored"]
        }
      }
    },
    "stable_benchmark_matched_result": {
      "type": "object", "additionalProperties": false,
      "required": [
        "domain", "mechanism", "panel", "baseline_arm", "candidate_arm",
        "baseline_value", "candidate_value", "delta", "metric", "unit",
        "n_pairs", "baseline_only", "candidate_only", "status"
      ],
      "properties": {
        "domain": {"type": "string", "minLength": 1, "maxLength": 120},
        "mechanism": {"type": "string", "minLength": 1, "maxLength": 120},
        "panel": {"type": "string", "minLength": 1, "maxLength": 120},
        "baseline_arm": {"type": "string", "minLength": 1, "maxLength": 240},
        "candidate_arm": {"type": "string", "minLength": 1, "maxLength": 240},
        "baseline_value": {"type": ["number", "null"], "minimum": 0, "maximum": 1000000000},
        "candidate_value": {"type": ["number", "null"], "minimum": 0, "maximum": 1000000000},
        "delta": {"type": "number", "minimum": -1000000000, "maximum": 1000000000},
        "metric": {"type": "string", "minLength": 1, "maxLength": 120},
        "unit": {"type": "string", "minLength": 1, "maxLength": 40},
        "n_pairs": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000},
        "baseline_only": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000},
        "candidate_only": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000},
        "status": {"type": "string", "minLength": 1, "maxLength": 80}
      }
    },
    "stable_benchmark_snapshot": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "observed_at", "status", "release", "measurement_review", "current_cohort",
        "next_run_preregistration", "scope", "warnings"
      ],
      "properties": {
        "schema_version": {"const": "weekly-stable-benchmark-snapshot/v1"},
        "observed_at": {"type": "string", "format": "date-time"},
        "status": {"enum": ["available", "unavailable"]},
        "release": {
          "oneOf": [
            {
              "type": "object", "additionalProperties": false,
              "required": ["suite_id", "version", "status", "published_at", "expires_at", "definition_sha256"],
              "properties": {
                "suite_id": {"type": "string", "minLength": 1, "maxLength": 160},
                "version": {"type": "string", "minLength": 1, "maxLength": 40},
                "status": {"enum": ["draft", "frozen", "review_required"]},
                "published_at": {"type": ["string", "null"], "format": "date-time"},
                "expires_at": {"type": "string", "format": "date-time"},
                "definition_sha256": {"$ref": "#/$defs/sha256"}
              }
            },
            {"type": "null"}
          ]
        },
        "measurement_review": {
          "oneOf": [
            {
              "type": "object", "additionalProperties": false,
              "required": [
                "status", "title", "summary", "affected_task_ids",
                "comparative_quality_allowed", "source_sha256"
              ],
              "properties": {
                "status": {"enum": ["commissioning_only", "unavailable"]},
                "title": {"type": "string", "minLength": 1, "maxLength": 500},
                "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
                "affected_task_ids": {
                  "type": "array", "maxItems": 64, "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1, "maxLength": 160}
                },
                "comparative_quality_allowed": {"const": false},
                "source_sha256": {
                  "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
                }
              }
            },
            {"type": "null"}
          ]
        },
        "current_cohort": {
          "oneOf": [
            {
              "type": "object", "additionalProperties": false,
              "required": [
                "comparison_id", "comparison_status", "progress_status",
                "completed_units", "total_units", "completed_calls", "total_call_ceiling",
                "receipt_admitted_arms", "unissued_arms", "paired_comparison_available",
                "arms", "matched_results"
              ],
              "properties": {
                "comparison_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 160},
                "comparison_status": {"type": "string", "minLength": 1, "maxLength": 80},
                "progress_status": {"type": "string", "minLength": 1, "maxLength": 80},
                "completed_units": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000},
                "total_units": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000},
                "completed_calls": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000},
                "total_call_ceiling": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000},
                "receipt_admitted_arms": {"type": "integer", "minimum": 0, "maximum": 8},
                "unissued_arms": {"type": "integer", "minimum": 0, "maximum": 8},
                "paired_comparison_available": {"type": "boolean"},
                "arms": {
                  "type": "array", "maxItems": 8,
                  "items": {"$ref": "#/$defs/stable_benchmark_arm"}
                },
                "matched_results": {
                  "type": "array", "maxItems": 16,
                  "items": {"$ref": "#/$defs/stable_benchmark_matched_result"}
                }
              }
            },
            {"type": "null"}
          ]
        },
        "next_run_preregistration": {
          "type": "object", "additionalProperties": false,
          "required": [
            "mode", "eligibility", "automatic_execution", "automatic_scheduling",
            "paid_api_calls", "definition_sha256", "registration_path_template",
            "required_sequence"
          ],
          "properties": {
            "mode": {"const": "manual_source_controlled_preregistration"},
            "eligibility": {
              "enum": [
                "same_release_preregistration_available", "explicit_release_review_required",
                "manual_preregistration_required", "measurement_review_required",
                "corrected_release_required",
                "release_evidence_unavailable"
              ]
            },
            "automatic_execution": {"const": false},
            "automatic_scheduling": {"const": false},
            "paid_api_calls": {"const": 0},
            "definition_sha256": {
              "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
            },
            "registration_path_template": {"const": "docs/benchmarks/registrations/<comparison_id>.json"},
            "required_sequence": {
              "type": "array", "maxItems": 6,
              "items": {"type": "string", "minLength": 1, "maxLength": 500}
            }
          }
        },
        "scope": {
          "type": "object", "additionalProperties": false,
          "required": [
            "claim", "omnibus_score", "full_orchestrator_claim",
            "external_rotations_included", "external_rotation_cadence",
            "external_rotation_rule", "receipt_admission_meaning",
            "measurement_validity", "promotion_authorized"
          ],
          "properties": {
            "claim": {"type": "string", "minLength": 1, "maxLength": 500},
            "omnibus_score": {"const": false},
            "full_orchestrator_claim": {"const": false},
            "external_rotations_included": {"const": false},
            "external_rotation_cadence": {"const": "monthly_or_preregistered_trigger"},
            "external_rotation_rule": {"type": "string", "minLength": 1, "maxLength": 500},
            "receipt_admission_meaning": {"type": "string", "minLength": 1, "maxLength": 500},
            "measurement_validity": {
              "enum": [
                "projection_unavailable", "unreviewed_claims_withheld",
                "review_unavailable_claims_withheld", "commissioning_only"
              ]
            },
            "promotion_authorized": {"const": false}
          }
        },
        "warnings": {
          "type": "array", "maxItems": 8,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    },
    "weekly_review_context": {
      "type": "object", "additionalProperties": false,
      "required": [
        "status", "week_id", "cycle_status", "review_status", "reviewed_at",
        "plan_repo_root", "plan_repo_head", "cycle_plan_sha256",
        "weekly_report_sha256", "reason", "recovery", "frontier_calls_repeated"
      ],
      "properties": {
        "status": {
          "enum": [
            "no_prior_review", "terminal_immutable_review",
            "incomplete_original_context_required"
          ]
        },
        "week_id": {"type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$"},
        "cycle_status": {"type": ["string", "null"], "minLength": 1, "maxLength": 80},
        "review_status": {"type": ["string", "null"], "minLength": 1, "maxLength": 80},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
        "plan_repo_root": {"type": ["string", "null"], "minLength": 1, "maxLength": 500},
        "plan_repo_head": {
          "oneOf": [
            {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
            {"type": "null"}
          ]
        },
        "cycle_plan_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "weekly_report_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "reason": {"type": "string", "minLength": 1, "maxLength": 1000},
        "recovery": {"type": ["string", "null"], "minLength": 1, "maxLength": 1000},
        "frontier_calls_repeated": {"const": false}
      }
    },
    "stable_benchmark_sunday_report": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "week_id", "recorded_at", "projection_role",
        "weekly_review_context", "stable_benchmark", "automatic_execution",
        "automatic_scheduling", "paid_api_calls", "promotion_authorized"
      ],
      "properties": {
        "schema_version": {"const": "weekly-stable-benchmark-sunday-report/v1"},
        "week_id": {"type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$"},
        "recorded_at": {"type": "string", "format": "date-time"},
        "projection_role": {"const": "rolling_read_only_non_evidentiary"},
        "weekly_review_context": {"$ref": "#/$defs/weekly_review_context"},
        "stable_benchmark": {"$ref": "#/$defs/stable_benchmark_snapshot"},
        "automatic_execution": {"const": false},
        "automatic_scheduling": {"const": false},
        "paid_api_calls": {"const": 0},
        "promotion_authorized": {"const": false}
      }
    },
    "run_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "run_id", "week_id", "snapshot_sha256", "snapshot",
        "source_packet_sha256", "providers", "budget"
      ],
      "properties": {
        "schema_version": {"const": "weekly-upgrade-run-v1"},
        "run_id": {"type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}-[0-9a-f]{12}$"},
        "week_id": {"type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$"},
        "snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "snapshot": {"type": "object"},
        "source_packet_sha256": {"$ref": "#/$defs/sha256"},
        "providers": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "prefixItems": [
            {
              "type": "object", "additionalProperties": false,
              "required": ["ordinal", "vendor", "role"],
              "properties": {
                "ordinal": {"const": 1}, "vendor": {"const": "codex"},
                "role": {"const": "upgrade_proposer"}
              }
            },
            {
              "type": "object", "additionalProperties": false,
              "required": ["ordinal", "vendor", "role"],
              "properties": {
                "ordinal": {"const": 2}, "vendor": {"const": "claude"},
                "role": {"const": "upgrade_adversary"}
              }
            }
          ],
          "items": false
        },
        "budget": {
          "type": "object", "additionalProperties": false,
          "required": [
            "frontier_calls", "total_deadline_s", "max_gpu_minutes",
            "call_timeout_s", "started_at", "deadline_at"
          ],
          "properties": {
            "frontier_calls": {"type": "integer", "minimum": 0, "maximum": 2},
            "total_deadline_s": {"type": "integer", "minimum": 1, "maximum": 7200},
            "max_gpu_minutes": {"type": "integer", "minimum": 0, "maximum": 120},
            "call_timeout_s": {"type": "integer", "minimum": 1, "maximum": 3600},
            "started_at": {"type": "string", "format": "date-time"},
            "deadline_at": {"type": "string", "format": "date-time"}
          }
        }
      }
    },
    "fetch_config": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "sources"],
      "properties": {
        "schema_version": {"const": "weekly-upgrade-fetch-v1"},
        "sources": {
          "type": "array", "minItems": 1, "maxItems": 12,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["url", "publisher", "published_at"],
            "properties": {
              "url": {"type": "string", "format": "uri", "pattern": "^https://"},
              "publisher": {"type": "string", "minLength": 1, "maxLength": 160},
              "published_at": {"type": ["string", "null"], "format": "date"}
            }
          }
        }
      }
    },
    "fetch_receipt": {
      "type": "object", "additionalProperties": false,
      "required": [
        "url", "final_url", "status", "retrieved_at", "http_status", "content_sha256",
        "byte_count", "error_category"
      ],
      "properties": {
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "final_url": {
          "oneOf": [
            {"type": "string", "format": "uri", "pattern": "^https://"},
            {"type": "null"}
          ]
        },
        "status": {"enum": ["FETCHED_UNVERIFIED", "FETCH_FAILED"]},
        "retrieved_at": {"type": ["string", "null"], "format": "date-time"},
        "http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
        "content_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "byte_count": {"type": "integer", "minimum": 0},
        "error_category": {
          "type": ["string", "null"],
          "enum": [
            "URL_REJECTED", "TIMEOUT", "HTTP_ERROR", "BYTE_LIMIT",
            "CONTENT_TYPE", "NETWORK_ERROR", "TOTAL_DEADLINE", null
          ]
        }
      }
    },
    "fetch_result": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "source_packet", "receipts", "bounds", "note"],
      "properties": {
        "schema_version": {"const": "weekly-upgrade-fetch-result-v1"},
        "source_packet": {"$ref": "#/$defs/source_packet"},
        "receipts": {
          "type": "array", "minItems": 1, "maxItems": 12,
          "items": {"$ref": "#/$defs/fetch_receipt"}
        },
        "bounds": {
          "type": "object", "additionalProperties": false,
          "required": ["request_timeout_s", "total_deadline_s", "max_bytes_per_source", "max_total_bytes"],
          "properties": {
            "request_timeout_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 30},
            "total_deadline_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 120},
            "max_bytes_per_source": {"type": "integer", "minimum": 1, "maximum": 262144},
            "max_total_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}
          }
        },
        "note": {"type": "string", "minLength": 1}
      }
    },
    "report": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "run_id", "week_id", "snapshot_sha256",
        "run_manifest_sha256", "status", "independence_loss",
        "frontier_calls_used", "proposal_sha256", "proposal", "adversary",
        "experiment_card", "reason", "reviewed_at"
      ],
      "properties": {
        "schema_version": {"const": "weekly-upgrade-report-v1"},
        "run_id": {"type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}-[0-9a-f]{12}$"},
        "week_id": {"type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$"},
        "snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "run_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "status": {
          "enum": [
            "FRONTIER_UNAVAILABLE", "INVALID_REPORT", "BUDGET_EXHAUSTED",
            "NO_CHANGE", "REVISION_REQUIRED", "CONTINUE_TRIAL"
          ]
        },
        "independence_loss": {"type": "boolean"},
        "frontier_calls_used": {"type": "integer", "minimum": 0, "maximum": 2},
        "proposal_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "proposal": {"oneOf": [{"$ref": "#/$defs/proposal"}, {"type": "null"}]},
        "adversary": {"oneOf": [{"$ref": "#/$defs/adversary"}, {"type": "null"}]},
        "experiment_card": {"oneOf": [{"$ref": "#/$defs/experiment_card"}, {"type": "null"}]},
        "stable_benchmark": {"$ref": "#/$defs/stable_benchmark_snapshot"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 1000},
        "reviewed_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
