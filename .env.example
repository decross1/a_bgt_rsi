# Copy to .env and fill in. Do NOT commit .env.
# Pre-flight (`preflight_credentials_staged`) checks all five are present.
#
# Semantic Scholar has a 24-48 hr application turnaround — apply first.

SEMANTIC_SCHOLAR_API_KEY=
ANTHROPIC_API_KEY=
HF_TOKEN=
GITHUB_TOKEN=
NVIDIA_API_KEY=

# DGX Spark LAN IP — used by day1_block2_unbox reachability check.
DGX_SPARK_LAN_IP=

# Local vLLM endpoint — wrapper + ML-Intern read this.
LOCAL_LLM_BASE_URL=http://localhost:8000/v1
