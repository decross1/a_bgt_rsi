# Secrets
.env
.env.local
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
.venv-*/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Plan-specific large assets — kept off git per Day 3 end-of-day note
books/
clones/
chroma_db/
!chroma_db/manifest.json
!chroma_db/.gitkeep

# Local model weights (would be at /mnt/models/* on Spark; never tracked)
models/

# Run-time outputs — not tracked by default; per-day end-of-day tasks
# git add specific files explicitly.
logs/*.jsonl
logs/*.log
bench/*.csv
bench/*.json
*.tmp
/tmp/

# Keep the empty dirs themselves
!logs/.gitkeep
!bench/.gitkeep

# Claude Code worktrees (parallel sessions per AGENT_PLAN.md)
.claude/worktrees/

# Side-track scratch logs (notes/track-*.md and notes/track-*.log)
notes/track-*.log

# agent_system framework symlinks (machine-local). The README.md
# documents the install command for reproducing the setup.
.agents/skills/
.agents/agents/

# Machine-generated apparatus state (LOOP_V0 + retired-framework
# leftovers). Past versions already in history are preserved; future
# growth stays local. See ARCHITECTURE.md §4 for the data plane.
run_state/active_iteration.json
run_state/loop_memory.jsonl
run_state/week1.run.jsonl
run_state/week1.state.json
run_state/attestations.jsonl
run_state/escalations.jsonl
run_state/claims.jsonl
run_state/iteration_cache/
run_state/coordinator_cycles.jsonl
run_state/health_signals.jsonl
run_state/skill_signals.jsonl
run_state/events.jsonl

# Layer-3 loop memory (per ARCHITECTURE.md §4.4) — sibling to chroma_db/
# (Layers 1+2). Machine-generated; one row per Nara iteration.
memory/*
!memory/.gitkeep

# Machine-generated journal entries from Nara iterations. The
# human-written daily journals (journal/dayN.md) stay committed.
journal/iterations/

# Live server stdout redirects + run registry + purge backups (D-047/D-048).
run_state/*.out
run_state/*.log
run_state/active_run.json
run_state/active_runs/
run_state/tool_plane_submits/
run_state/*.pre_purge_*
logs/*.pre_purge_*

# β-interim machine state + sentinels (D-049) — never committed.
run_state/coordinator_budget.jsonl
run_state/d049_ratified
run_state/pause_coordinator
run_state/.coordinator-cron.lock
